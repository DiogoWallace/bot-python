# Conexão com o SQL Server (driver ODBC 18)
DATABASE_URL="DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=DB_MANAGER;UID=usuario;PWD=senha;TrustServerCertificate=yes"

# Gateway do WhatsApp (Evolution API)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="troque-pela-sua-chave"

# Token compartilhado com o gateway: o webhook exige o cabeçalho X-Webhook-Token
WEBHOOK_TOKEN="troque-por-um-valor-aleatorio"

# Números autorizados (JSON). Exemplo fictício:
AUTHORIZED_NUMBERS='{"5535999999999": {"permission": "gestor", "cluster": "49", "name": "Fulano"}}'
